# Copia este archivo como ".env" dentro de la carpeta backend y llena los valores.
# El archivo .env NUNCA se sube a GitHub (ya está en .gitignore).

# Supabase → Project Settings → Data API → Project URL
SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Supabase → Project Settings → API Keys → Publishable key (sb_publishable_...)
SUPABASE_PUBLISHABLE_KEY=

# Supabase → Project Settings → API Keys → pestaña "Legacy API keys" → service_role (empieza con eyJ...).
# Solo vive en el backend. Sirve para crear cuentas y manejar archivos de Storage.
SUPABASE_SECRET_KEY=

# Supabase → botón "Connect" (arriba) → pestaña "Connection String".
#  - En tu computadora: "Session pooler"   (puerto 5432)
#  - En Vercel:         "Transaction pooler" (puerto 6543)
# Cambia [YOUR-PASSWORD] por la contraseña de la base de datos.
DATABASE_URL=postgresql://postgres.TU-PROYECTO:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Direcciones desde donde el frontend puede llamar al backend (separadas por coma)
CORS_ORIGINS=http://localhost:5173

# Bucket de Supabase Storage para los materiales
STORAGE_BUCKET=materiales
